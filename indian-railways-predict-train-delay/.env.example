# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE — RAILWAY ETA FORECASTING SYSTEM
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific credentials.
# Do NOT commit actual secrets or production passwords into version control.

# Application Settings
PROJECT_NAME="Dynamic Railway ETA Forecast using PCA & ML"
ENVIRONMENT="development"
DEBUG=True

# Security & Authentication (Argon2id + JWT)
SECRET_KEY="replace-with-a-cryptographically-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# PostgreSQL (Production / Docker):
# DATABASE_URL="postgresql+psycopg2://railway_user:secure_password@localhost:5432/railway_eta_db"
#
# SQLite fallback (Local zero-config dev):
DATABASE_URL="sqlite:///./railway_eta.db"

# Model Artifact Paths (Relative to backend or absolute)
MODEL_ARTIFACT_PATH="./artifacts/pca_delay_model.joblib"
MODEL_METADATA_PATH="./artifacts/model_metadata.json"

# Operational Railway Telemetry Feed Integration (Optional)
# If an authorized real-time Indian Railways (FOIS/NTES) feed becomes available:
RAILWAY_FEED_API_KEY=""
RAILWAY_FEED_ENDPOINT=""
